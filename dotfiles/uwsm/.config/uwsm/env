# Changes require a restart to take effect.

# Ensure Omarchy bins are in the path
export OMARCHY_PATH=$HOME/.local/share/omarchy
export PATH=$OMARCHY_PATH/bin:$PATH

# ── AMD iGPU (Krackan 840M/860M) monitor-hotplug crash workarounds ─────────────
# Diagnostic workarounds for Hyprland/aquamarine SIGSEGV/SIGABRT when plugging or
# unplugging a monitor on this AMD iGPU. Both need a full logout/login to apply
# (aquamarine reads them at process init — Hyprland's `env =` in hypr/envs.conf is
# too late, and `hyprctl reload` does NOT apply them either).
# Remove each once its upstream fix is in our installed Hyprland/aquamarine and
# hotplug is stable without it.
#
# AQ_NO_ATOMIC — disable aquamarine atomic KMS commits (legacy page-flip fallback).
#   Stops the "atomic drm request: failed to commit: Device or resource busy"
#   page-flip floods on the AMD iGPU + DisplayPort MST link (dock/daisy-chain).
#   Upstream calls this "heavily not recommended" long-term; it's a diagnostic.
#   Track (remove when fixed/closed):
#     https://github.com/hyprwm/Hyprland/discussions/10248   (open; fix = aquamarine PR #316)
#     https://github.com/hyprwm/aquamarine/issues/307
#     https://github.com/hyprwm/aquamarine/issues/272
export AQ_NO_ATOMIC=1
#
# AQ_NO_MODIFIERS — disable DRM format modifiers so dmabuf import stops failing with
#   "eglCreateImageKHR EGL_BAD_PARAMETER: plane attribute(s) missing" in the
#   screencopy / screen-share path. Today's crash only fires when a screencast is
#   active at hotplug: onOutputCommit -> copyDmabuf -> getOrCreateRenderbuffer ->
#   bad_variant_access -> SIGSEGV.
#   Track (remove when fixed/closed):
#     https://github.com/hyprwm/Hyprland/discussions/14857   (reported fixed by PR #15048 / commit 08e2b6e — re-verify after each Hyprland update)
#     https://github.com/hyprwm/Hyprland/issues/2241
export AQ_NO_MODIFIERS=1
# ──────────────────────────────────────────────────────────────────────────────

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
omarchy-cmd-present mise && eval "$(mise activate bash --shims)"
